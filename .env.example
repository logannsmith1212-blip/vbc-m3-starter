# Copy this file to .env.local and fill in your own values.
# Find both in Supabase: Project Settings → API Keys (Project URL, secret key).
# The secret key bypasses Row Level Security: server-side only, never commit it,
# and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
